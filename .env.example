# Restock Radar Configuration

# Environment & Clock
SIM_NOW=
DEFAULT_LANGUAGE=en

# Database & Celery
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shelfwatcher
BROKER_URL=sqla+postgresql://postgres:postgres@localhost:5432/shelfwatcher

# Vision & Ingestion
CAPTURE_INTERVAL_MIN=15
CONF_THRESHOLD=0.40
IOU_NMS=0.50
N_CONSISTENT=2
MISS_TOLERANCE_FRAMES=3
PUTBACK_WINDOW_MIN=5
REFILL_DELTA=30

# Inventory & Reorder
SERVICE_LEVEL=0.95
BUFFER_HOURS=12
TARGET_COVER_DAYS=7
APPROVAL_LIMIT_VALUE=20000
APPROVAL_LIMIT_QTY=200
MAX_AUTO_ORDERS_PER_DAY=10
MAX_AUTO_SPEND_PER_DAY=50000
FILL_TARGET=85
RECHECK_TIME=10:00
SUMMARY_TIME=08:00

# Safety & Controls
AGENT_ENABLED=true
DRY_RUN=true

# Generative AI & LLM
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=

# Email / Mock SMTP
SMTP_HOST=localhost
SMTP_PORT=8025
SMTP_USER=
SMTP_PASS=
FROM_ADDR=procurement@restockradar.local
